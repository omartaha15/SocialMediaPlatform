@using SocialMedia.Domain.Entities
@model IEnumerable<ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Friends | Zuvo";
    var receivedRequests = ViewBag.PendingRequests as IEnumerable<ApplicationUser> ?? new List<ApplicationUser>();
    var sentRequests = ViewBag.SentRequests as IEnumerable<ApplicationUser> ?? new List<ApplicationUser>();
    var friendsCount = ViewBag.FriendsCount ?? 0;
    var user = await UserManager.GetUserAsync(User);
    var currentUserPic = string.IsNullOrEmpty(user?.ProfilePictureUrl) ? "/images/user.jpg" : user.ProfilePictureUrl;
}

<div class="container py-4" style="max-width: 1440px;">
    <div class="row g-4">
        
        <!-- Left Column: Navigation & Profile -->
        <aside class="col-xl-3 d-none d-xl-flex flex-column gap-4">
            <div class="position-sticky" style="top: 85px;">
                <!-- Profile Card (Zuvo Style) -->
                <div class="card fb-card p-6 mb-4 overflow-hidden">
                    <div class="flex flex-col items-center text-center p-4">
                        <div class="position-relative mb-4 d-inline-block">
                            <div class="rounded-circle p-1 bg-gradient-primary" style="width: 96px; height: 96px;">
                                <img src="@currentUserPic" class="w-100 h-100 object-fit-cover rounded-circle border border-4 border-white shadow-sm" onerror="this.src='/images/user.jpg';" />
                            </div>
                        </div>
                        <h2 class="h5 fw-bold text-on-surface mb-1">@user?.UserName</h2>
                        <p class="text-muted small px-2">@user?.Email</p>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <div class="card fb-card p-2 mb-4 bg-surface-container-low bg-opacity-50">
                    <div class="list-group list-group-flush gap-2">
                        <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 text-muted hover-bg-white transition-all rounded-4 border-0">
                            <span class="material-symbols-outlined">home</span>
                            <span class="fw-medium">Home Feed</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 bg-white text-primary shadow-sm rounded-4 border-0">
                            <span class="material-symbols-outlined">group</span>
                            <span class="fw-semibold">Friends</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Suggestions" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 text-muted hover-bg-white transition-all rounded-4 border-0">
                            <span class="material-symbols-outlined">explore</span>
                            <span class="fw-medium">Discover</span>
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Middle Column: Friends Management -->
        <main class="col-lg-12 col-xl-9">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-5 px-2">
                <div>
                    <h1 class="h3 fw-bold text-on-surface mb-1">Friends</h1>
                    <p class="text-muted small mb-0">Manage your connections and pending requests</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Friendship" asp-action="Suggestions" class="btn btn-fb-primary btn-sm px-4">
                        Discover People
                    </a>
                </div>
            </div>

            <!-- Tabs Navigation (SaaS Style) -->
            <ul class="nav nav-pills gap-3 mb-5 px-2 border-0" id="friendshipTabs" role="tablist">
                <li class="nav-item">
                    <button class="btn btn-light rounded-pill px-4 py-2 fw-bold active transition-all" id="friends-tab" data-bs-toggle="pill" data-bs-target="#friends" type="button" role="tab" style="font-size: 0.85rem;">
                        My Friends (@friendsCount)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="btn btn-light rounded-pill px-4 py-2 fw-bold transition-all position-relative" id="requests-tab" data-bs-toggle="pill" data-bs-target="#requests" type="button" role="tab" style="font-size: 0.85rem;">
                        Received Requests
                        @if (receivedRequests.Any())
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger" style="width: 18px; height: 18px; font-size: 10px; padding: 0; display: flex; align-items: center; justify-content: center;">@receivedRequests.Count()</span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button class="btn btn-light rounded-pill px-4 py-2 fw-bold transition-all" id="pending-tab" data-bs-toggle="pill" data-bs-target="#pending" type="button" role="tab" style="font-size: 0.85rem;">
                        Sent Requests (@sentRequests.Count())
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="friendshipTabsContent">
                <!-- Friends Tab -->
                <div class="tab-pane fade show active" id="friends" role="tabpanel">
                    <div class="row g-4">
                        @if (!Model.Any())
                        {
                            <div class="col-12">
                                <div class="card fb-card text-center py-5 border-dashed">
                                    <div class="card-body">
                                        <span class="material-symbols-outlined text-muted opacity-25 mb-3" style="font-size: 64px;">group_off</span>
                                        <h5 class="fw-bold">No friends yet</h5>
                                        <p class="text-muted small">Start exploring to find people you know.</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var friend in Model)
                            {
                                <div class="col-md-6 col-lg-4 col-xl-3">
                                    <div class="card fb-card overflow-hidden hover-shadow transition-all border-0">
                                        <div class="bg-gradient-primary" style="height: 60px;"></div>
                                        <div class="card-body text-center pt-0">
                                            <div class="mt-n5 position-relative">
                                                <img src="@friend.ProfilePictureUrl" class="rounded-circle border border-4 border-white shadow-sm" style="width: 80px; height: 80px; object-fit: cover; margin-top: -40px;" onerror="this.src='/images/user.jpg';" />
                                            </div>
                                            <a asp-controller="Profile" asp-action="Index" asp-route-id="@friend.Id" class="h6 fw-bold text-on-surface d-block mt-3 mb-1 text-decoration-none hover-text-primary">@friend.UserName</a>
                                            <p class="text-muted small mb-4">Zuvo Member</p>
                                            
                                            <div class="d-grid gap-2">
                                                <a asp-controller="Messaging" asp-action="Chat" asp-route-otherUserId="@friend.Id" class="btn btn-light btn-sm fw-bold rounded-3">Message</a>
                                                <form asp-controller="Friendship" asp-action="RemoveFriend" method="post">
                                                    <input type="hidden" name="friendId" value="@friend.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold rounded-3 w-100 opacity-75">Unfriend</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Received Requests Tab -->
                <div class="tab-pane fade" id="requests" role="tabpanel">
                    <div class="row g-4">
                        @if (!receivedRequests.Any())
                        {
                            <div class="col-12">
                                <div class="card fb-card text-center py-5 border-dashed">
                                    <div class="card-body">
                                        <span class="material-symbols-outlined text-muted opacity-25 mb-3" style="font-size: 64px;">check_circle</span>
                                        <h5 class="fw-bold">No pending requests</h5>
                                        <p class="text-muted small">You're all caught up!</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var sender in receivedRequests)
                            {
                                <div class="col-md-6 col-lg-4 col-xl-3">
                                    <div class="card fb-card overflow-hidden border-0">
                                        <div class="card-body text-center">
                                            <img src="@sender.ProfilePictureUrl" class="rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/images/user.jpg';" />
                                            <h6 class="fw-bold mb-1">@sender.UserName</h6>
                                            <p class="text-muted small mb-4">Wants to be friends</p>
                                            <div class="d-grid gap-2">
                                                <form asp-controller="Friendship" asp-action="AcceptRequest" method="post">
                                                    <input type="hidden" name="senderId" value="@sender.Id" />
                                                    <button type="submit" class="btn btn-primary btn-sm fw-bold rounded-3 w-100">Accept</button>
                                                </form>
                                                <form asp-controller="Friendship" asp-action="RemoveFriend" method="post">
                                                    <input type="hidden" name="friendId" value="@sender.Id" />
                                                    <button type="submit" class="btn btn-light btn-sm fw-bold rounded-3 w-100">Decline</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Sent Requests Tab -->
                <div class="tab-pane fade" id="pending" role="tabpanel">
                    <div class="row g-4">
                        @if (!sentRequests.Any())
                        {
                            <div class="col-12">
                                <div class="card fb-card text-center py-5 border-dashed">
                                    <div class="card-body">
                                        <span class="material-symbols-outlined text-muted opacity-25 mb-3" style="font-size: 64px;">send</span>
                                        <h5 class="fw-bold">No sent requests</h5>
                                        <p class="text-muted small">Send some requests to grow your network.</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var receiver in sentRequests)
                            {
                                <div class="col-md-6 col-lg-4 col-xl-3">
                                    <div class="card fb-card overflow-hidden border-0">
                                        <div class="card-body text-center">
                                            <img src="@receiver.ProfilePictureUrl" class="rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/images/user.jpg';" />
                                            <h6 class="fw-bold mb-1">@receiver.UserName</h6>
                                            <p class="text-muted small mb-4">Request Sent</p>
                                            <form asp-controller="Friendship" asp-action="RemoveFriend" method="post">
                                                <input type="hidden" name="friendId" value="@receiver.Id" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm fw-bold rounded-3 w-100">Cancel Request</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .nav-pills .nav-item .btn.active {
        background-color: var(--primary) !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(74, 63, 226, 0.2);
    }
    .border-dashed {
        border: 2px dashed var(--surface-container-high) !important;
    }
    .mt-n5 {
        margin-top: -3rem !important;
    }
    .hover-text-primary:hover {
        color: var(--primary) !important;
    }
</style>

@using SocialMedia.Application.DTOs.Pagination
@using SocialMedia.Application.DTOs.ProfileDTOs
@model PaginatedList<UserSuggestionDto>
@using Microsoft.AspNetCore.Identity
@using SocialMedia.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Discover People | Zuvo";
    var user = await UserManager.GetUserAsync(User);
    var currentUserPic = string.IsNullOrEmpty(user?.ProfilePictureUrl) ? "/images/user.jpg" : user.ProfilePictureUrl;
}

<div class="container py-4" style="max-width: 1440px;">
    <div class="row g-4">
        
        <!-- Left Column: Navigation & Profile -->
        <aside class="col-xl-3 d-none d-xl-flex flex-column gap-4">
            <div class="position-sticky" style="top: 85px;">
                <!-- Profile Card -->
                <div class="card fb-card p-6 mb-4 overflow-hidden">
                    <div class="flex flex-col items-center text-center p-4">
                        <div class="position-relative mb-4 d-inline-block">
                            <div class="rounded-circle p-1 bg-gradient-primary" style="width: 96px; height: 96px;">
                                <img src="@currentUserPic" class="w-100 h-100 object-fit-cover rounded-circle border border-4 border-white shadow-sm" onerror="this.src='/images/user.jpg';" />
                            </div>
                        </div>
                        <h2 class="h5 fw-bold text-on-surface mb-1">@user?.UserName</h2>
                        <p class="text-muted small px-2">@user?.Email</p>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <div class="card fb-card p-2 mb-4 bg-surface-container-low bg-opacity-50">
                    <div class="list-group list-group-flush gap-2">
                        <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 text-muted hover-bg-white transition-all rounded-4 border-0">
                            <span class="material-symbols-outlined">home</span>
                            <span class="fw-medium">Home Feed</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 text-muted hover-bg-white transition-all rounded-4 border-0">
                            <span class="material-symbols-outlined">group</span>
                            <span class="fw-medium">Friends</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Suggestions" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 bg-white text-primary shadow-sm rounded-4 border-0">
                            <span class="material-symbols-outlined">explore</span>
                            <span class="fw-semibold">Discover</span>
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Middle Column: Suggestions -->
        <main class="col-lg-12 col-xl-9">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-5 px-2">
                <div>
                    <h1 class="h3 fw-bold text-on-surface mb-1">Discover People</h1>
                    <p class="text-muted small mb-0">Expand your network with people you may know</p>
                </div>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="card fb-card text-center py-5 border-dashed">
                    <div class="card-body">
                        <span class="material-symbols-outlined text-muted opacity-25 mb-3" style="font-size: 64px;">search_off</span>
                        <h5 class="fw-bold">No suggestions found</h5>
                        <p class="text-muted small">We'll notify you when we find more people you might know.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var suggestion in Model.Items)
                    {
                        <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="card fb-card overflow-hidden hover-shadow transition-all border-0">
                                <div class="position-relative overflow-hidden" style="height: 140px;">
                                    <img src="https://images.unsplash.com/photo-1614850523296-d8c1af93d400?w=500&auto=format&fit=crop&q=60" class="w-100 h-100 object-fit-cover" />
                                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-to-t" style="background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);">
                                    </div>
                                </div>
                                <div class="card-body text-center pt-0">
                                    <div class="mt-n5 position-relative">
                                        <img src="@suggestion.ProfilePictureUrl" class="rounded-circle border border-4 border-white shadow-sm" style="width: 80px; height: 80px; object-fit: cover; margin-top: -40px;" onerror="this.src='/images/user.jpg';" />
                                    </div>
                                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@suggestion.Id" class="h6 fw-bold text-on-surface d-block mt-3 mb-1 text-decoration-none hover-text-primary">@suggestion.UserName</a>
                                    
                                    <div style="min-height: 24px;">
                                        @if (suggestion.MutualFriendsCount > 0)
                                        {
                                            <p class="text-muted small mb-3">@suggestion.MutualFriendsCount mutual friends</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-3">New to Zuvo</p>
                                        }
                                    </div>
                                    
                                    <div class="d-grid">
                                        <form asp-controller="Friendship" asp-action="SendRequest" method="post">
                                            <input type="hidden" name="receiverId" value="@suggestion.Id" />
                                            <button type="submit" class="btn btn-fb-primary btn-sm w-100 fw-bold">
                                                Add Friend
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination (Modern) -->
                <div class="d-flex justify-content-between align-items-center mt-5 px-2">
                    <p class="text-muted small mb-0 fw-medium">
                        Page <span class="text-primary fw-bold">@Model.PageIndex</span> of @Model.TotalPages
                    </p>
                    <div class="d-flex gap-2">
                        <a asp-action="Suggestions" asp-route-pageNumber="@(Model.PageIndex - 1)" 
                           class="btn btn-light rounded-pill px-4 btn-sm fw-bold @(!Model.HasPreviousPage ? "disabled opacity-50" : "")">
                            Previous
                        </a>
                        <a asp-action="Suggestions" asp-route-pageNumber="@(Model.PageIndex + 1)" 
                           class="btn btn-light rounded-pill px-4 btn-sm fw-bold @(!Model.HasNextPage ? "disabled opacity-50" : "")">
                            Next
                        </a>
                    </div>
                </div>
            }
        </main>
    </div>
</div>

<style>
    .border-dashed {
        border: 2px dashed var(--surface-container-high) !important;
    }
    .mt-n5 {
        margin-top: -3rem !important;
    }
    .hover-text-primary:hover {
        color: var(--primary) !important;
    }
    .btn.disabled {
        pointer-events: none;
    }
</style>

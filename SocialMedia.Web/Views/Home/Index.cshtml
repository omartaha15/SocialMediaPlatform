@model IEnumerable<SocialMedia.Application.DTOs.PostDtos.PostDto>
@using Microsoft.AspNetCore.Identity
@using SocialMedia.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Zuvo | Social Intelligence";
    var user = await UserManager.GetUserAsync(User);
    var currentUserName = user?.UserName ?? "User";
    var currentUserPic = string.IsNullOrEmpty(user?.ProfilePictureUrl) ? "/images/user.jpg" : user.ProfilePictureUrl;
}

<style>
    /* Homepage-specific polish */
    .zuvo-profile-card { overflow: hidden; }
    .zuvo-profile-card .profile-avatar-ring {
        width: 96px; height: 96px;
        padding: 3px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 50%;
        display: inline-block;
    }
    .zuvo-profile-card .profile-avatar-ring img {
        width: 100%; height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid white;
    }
    .zuvo-stat { text-align: center; }
    .zuvo-stat .stat-value {
        display: block;
        font-size: 1.15rem;
        font-weight: 800;
        font-family: var(--font-headline);
        color: var(--primary);
    }
    .zuvo-stat .stat-label {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-muted);
        font-weight: 600;
    }
    .zuvo-sidebar-nav .nav-item {
        display: flex; align-items: center; gap: 14px;
        padding: 0.7rem 1rem;
        border-radius: var(--radius-lg);
        color: var(--on-surface-variant);
        font-weight: 500; font-size: 0.88rem;
        transition: var(--transition);
        text-decoration: none;
        cursor: pointer;
    }
    .zuvo-sidebar-nav .nav-item:hover {
        background: rgba(255,255,255,0.6);
        color: var(--on-surface);
    }
    .zuvo-sidebar-nav .nav-item.active {
        background: white;
        color: var(--primary);
        box-shadow: var(--shadow-sm);
        font-weight: 600;
    }
    .zuvo-sidebar-nav .nav-item .material-symbols-outlined {
        font-size: 22px;
    }
    .zuvo-widget-title {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--text-muted);
        font-weight: 700;
    }
    .zuvo-contact-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.15rem 0;
    }
    .zuvo-contact-item .contact-avatar {
        position: relative;
    }
    .zuvo-contact-item .contact-avatar img {
        width: 32px; height: 32px; border-radius: 50%; object-fit: cover;
    }
    .zuvo-contact-item .contact-avatar .online-dot {
        position: absolute; bottom: 0; right: 0;
        width: 10px; height: 10px;
        background: var(--success);
        border: 2px solid white;
        border-radius: 50%;
    }
    .zuvo-contact-item .contact-name {
        font-size: 0.88rem; font-weight: 500; color: var(--on-surface);
    }
    .zuvo-pulse-dot {
        width: 8px; height: 8px;
        background: var(--primary);
        border-radius: 50%;
        animation: pulse 2s ease infinite;
        box-shadow: 0 0 8px rgba(74, 63, 226, 0.6);
    }
    .zuvo-birthday-item {
        display: flex; align-items: center; gap: 12px;
    }
    .zuvo-birthday-item img {
        width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
    }
    .zuvo-birthday-item .bday-name { font-size: 0.88rem; font-weight: 600; }
    .zuvo-birthday-item .bday-date { font-size: 0.72rem; color: var(--text-muted); }

    .zuvo-sponsored-card .sponsored-img {
        width: 100%; aspect-ratio: 16/9; object-fit: cover;
        border-radius: var(--radius-lg);
    }

    .feed-section-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-weight: 700;
        color: var(--text-muted);
    }
</style>

<!-- Main Content Layout -->
<div class="container py-4" style="max-width: 1440px;">
    <div class="row g-4 align-items-start">

        <!-- ═══ LEFT COLUMN ═══ -->
        <aside class="col-xl-3 d-none d-xl-block">
            <div class="position-sticky" style="top: 85px;">

                <!-- Profile Card -->
                <div class="card fb-card zuvo-profile-card p-0 mb-4">
                    <div class="text-center px-4 pt-5 pb-4">
                        <div class="position-relative d-inline-block mb-3">
                            <div class="profile-avatar-ring">
                                <img src="@currentUserPic" alt="@currentUserName" onerror="this.src='/images/user.jpg';" />
                            </div>
                            <div class="position-absolute" style="bottom: 4px; right: 4px; width: 16px; height: 16px; background: var(--success); border: 3px solid white; border-radius: 50%;"></div>
                        </div>
                        <h2 class="h5 fw-bold mb-1" style="color: var(--on-surface);">@currentUserName</h2>
                        <p class="text-muted small mb-0 px-3" style="line-height: 1.55;">Product Designer focused on building sustainable digital ecosystems at Zuvo.</p>
                    </div>
                    <div class="d-flex border-top" style="border-color: var(--surface-container-low) !important;">
                        <div class="zuvo-stat flex-fill py-3 border-end" style="border-color: var(--surface-container-low) !important;">
                            <span class="stat-value">1.2k</span>
                            <span class="stat-label">Followers</span>
                        </div>
                        <div class="zuvo-stat flex-fill py-3">
                            <span class="stat-value">482</span>
                            <span class="stat-label">Following</span>
                        </div>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <div class="card fb-card p-3 mb-4" style="background-color: rgba(238, 241, 243, 0.5) !important; backdrop-filter: blur(8px);">
                    <nav class="zuvo-sidebar-nav d-flex flex-column gap-1">
                        <a asp-controller="Profile" asp-action="Index" class="nav-item active">
                            <span class="material-symbols-outlined">person</span>
                            <span>My Profile</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Index" class="nav-item">
                            <span class="material-symbols-outlined">group</span>
                            <span>Friends</span>
                        </a>
                        <a asp-controller="Friendship" asp-action="Suggestions" class="nav-item">
                            <span class="material-symbols-outlined">explore</span>
                            <span>Discover</span>
                        </a>
                        <a href="#" class="nav-item">
                            <span class="material-symbols-outlined">settings</span>
                            <span>Settings</span>
                        </a>
                    </nav>
                </div>

                <!-- Create Post CTA -->
                <button class="btn btn-fb-primary w-100 py-3" onclick="document.querySelector('.compose-textarea')?.focus()">
                    Create Post
                </button>
            </div>
        </aside>

        <!-- ═══ MIDDLE COLUMN — FEED ═══ -->
        <main class="col-12 col-md-8 col-xl-6">

            <!-- Compose Post -->
            <div class="mb-4">
                <partial name="_ComposePostPartial" />
            </div>

            <!-- Feed Items -->
            <div id="feed-posts-container" class="d-flex flex-column gap-4">
                @if (Model != null && Model.Any())
                {
                    @foreach (var post in Model)
                    {
                        <partial name="_PostPartial" model="post" />
                    }
                }
                else
                {
                    <div class="card fb-card text-center py-5">
                        <div class="card-body py-4">
                            <div class="mb-4" style="color: var(--surface-container-high);">
                                <span class="material-symbols-outlined" style="font-size: 72px;">dynamic_feed</span>
                            </div>
                            <h5 class="fw-bold mb-2">Your feed is empty</h5>
                            <p class="text-muted small mb-4">Follow people or share something to get started.</p>
                            <a asp-controller="Friendship" asp-action="Suggestions" class="btn btn-fb-primary btn-sm px-4">Discover People</a>
                        </div>
                    </div>
                }
            </div>

            <!-- Loading Indicator -->
            <div id="feed-loading" class="text-center py-5" style="display: none;">
                <div class="spinner-border" style="width: 1.5rem; height: 1.5rem; color: var(--primary);" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </main>

        <!-- ═══ RIGHT COLUMN ═══ -->
        <aside class="col-md-4 col-xl-3 d-none d-md-block">
            <div class="position-sticky" style="top: 85px;">

                <!-- Sponsored Card -->
                <div class="card fb-card zuvo-sponsored-card p-5 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="zuvo-widget-title">Sponsored</span>
                        <span class="material-symbols-outlined" style="font-size: 14px; color: var(--outline-variant);">info</span>
                    </div>
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=500&auto=format&fit=crop&q=60" class="sponsored-img mb-3" alt="Zuvo Analytics" />
                    <h4 style="font-size: 0.88rem; font-weight: 700; color: var(--on-surface); margin-bottom: 4px;">Scale your business with Zuvo Analytics</h4>
                    <p class="text-muted mb-3" style="font-size: 0.75rem; line-height: 1.6;">Real-time social intelligence at your fingertips. Get started with a 14-day free trial.</p>
                    <button class="btn btn-sm w-100 rounded-pill fw-bold" style="font-size: 0.75rem; border: 1.5px solid rgba(74, 63, 226, 0.2); color: var(--primary); background: transparent;">Learn More</button>
                </div>

                <!-- Birthdays Card -->
                <div class="card fb-card p-5 mb-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px; background: var(--secondary-container);">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; color: var(--secondary); font-size: 20px;">cake</span>
                        </div>
                        <h3 style="font-size: 0.88rem; font-weight: 700; color: var(--on-surface); margin: 0;">Upcoming Birthdays</h3>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        <div class="zuvo-birthday-item">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=60" alt="Marcus" />
                            <div>
                                <div class="bday-name">Marcus Chen</div>
                                <div class="bday-date">Birthday today!</div>
                            </div>
                        </div>
                        <div class="zuvo-birthday-item">
                            <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&auto=format&fit=crop&q=60" alt="Sarah" />
                            <div>
                                <div class="bday-name">Sarah Jenkins</div>
                                <div class="bday-date">Tomorrow</div>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm w-100 rounded-3 fw-bold mt-4 py-2" style="font-size: 0.75rem; background: var(--surface-container-low); color: var(--on-surface-variant); border: none;">View All Birthdays</button>
                </div>

                <!-- Active Contacts -->
                <div class="card fb-card p-5">
                    <h3 style="font-size: 0.88rem; font-weight: 700; color: var(--on-surface); margin-bottom: 1.25rem;">Active Contacts</h3>
                    <div class="d-flex flex-column gap-3">
                        <div class="zuvo-contact-item">
                            <div class="d-flex align-items-center gap-3">
                                <div class="contact-avatar">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=60" alt="Alex" />
                                    <div class="online-dot"></div>
                                </div>
                                <span class="contact-name">Alex Rivera</span>
                            </div>
                            <div class="zuvo-pulse-dot"></div>
                        </div>
                        <div class="zuvo-contact-item">
                            <div class="d-flex align-items-center gap-3">
                                <div class="contact-avatar">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=60" alt="Jordan" />
                                    <div class="online-dot"></div>
                                </div>
                                <span class="contact-name">Jordan Smith</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </aside>

    </div>
</div>

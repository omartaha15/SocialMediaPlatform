@using Microsoft.AspNetCore.Identity
@using SocialMedia.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    var userLocal = await UserManager.GetUserAsync(User);
    var currentUserNameLocal = userLocal?.UserName ?? "User";
    var currentUserPicLocal = string.IsNullOrEmpty(userLocal?.ProfilePictureUrl) ? "/images/user.jpg" : userLocal.ProfilePictureUrl;
}

<!-- COMPOSE CARD -->
<div class="card fb-card p-4 mb-4 shadow-sm border-0">
    <div class="d-flex gap-3">
        <div class="flex-shrink-0">
            <img src="@currentUserPicLocal" class="rounded-circle shadow-sm" style="width: 52px; height: 52px; object-fit: cover;" onerror="this.src='/images/user.jpg';" />
        </div>
        <div class="flex-grow-1">
            <div class="compose-form-wrap" id="compose-form-wrap">
                <form asp-controller="Post" asp-action="CreatePost" method="post" enctype="multipart/form-data">
                    <textarea id="compose-textarea" name="Content" class="form-control border-0 bg-light rounded-4 px-3 py-3 shadow-none mb-3" rows="3" style="resize: none; color: var(--text-primary); font-size: 0.95rem; background-color: var(--bg-input) !important;" placeholder="What's on your mind, @currentUserNameLocal.Split(' ')[0]?" required></textarea>
                    
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top" style="border-color: rgba(0,0,0,0.05) !important;">
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 rounded-pill hover-bg-light transition-all border-0 bg-transparent text-muted fw-semibold" style="font-size: 0.8rem;">
                                <span class="material-symbols-outlined text-danger" style="font-variation-settings: 'FILL' 1;">videocam</span>
                                Live Video
                            </button>

                            <label class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 rounded-pill hover-bg-light transition-all border-0 bg-transparent text-muted fw-semibold m-0" for="compose-image" style="font-size: 0.8rem;">
                                <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">image</span>
                                Photo
                                <input type="file" id="compose-image" name="Image" accept="image/*" style="display:none;" onchange="document.getElementById('img-name').textContent = this.files[0]?.name || '';" />
                            </label>
                            
                            <button type="button" class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 rounded-pill hover-bg-light transition-all border-0 bg-transparent text-muted fw-semibold" style="font-size: 0.8rem;">
                                <span class="material-symbols-outlined text-tertiary" style="font-variation-settings: 'FILL' 1;">mood</span>
                                Feeling
                            </button>
                        </div>
                        
                        <div class="d-flex align-items-center gap-2">
                             <div id="img-name" class="small text-muted mb-0"></div>
                             <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="font-size: 0.85rem;">
                                Post
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using SocialMedia.Domain.Entities
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zuvo</title>
    <!-- Apply theme ASAP to prevent flash of wrong theme -->
    <script>
        (function() {
            var saved = localStorage.getItem('zuvo-theme');
            if (saved === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMedia.Web.styles.css" asp-append-version="true" />
    <style>
        /* ── Zuvo Lumina — Global ── */
        body {
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        /* ── Glassmorphic Navbar ── */
        .navbar-fb {
            background: rgba(255, 255, 255, 0.80) !important;
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            box-shadow: 0 8px 30px rgba(0,0,0,0.04);
            border-bottom: none !important;
        }
        [data-theme="dark"] .navbar-fb {
            background: rgba(11, 15, 16, 0.80) !important;
        }

        /* Brand */
        .navbar-fb .navbar-brand {
            color: var(--text-primary) !important;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.6rem;
            letter-spacing: -0.04em;
            margin-right: 0;
        }
        .navbar-fb .navbar-brand i { display: none; }

        /* ── Text Nav Links (Stitch style) ── */
        .navbar-fb .zuvo-nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.02em;
        }
        .navbar-fb .zuvo-nav-link {
            color: rgba(44, 47, 49, 0.5) !important;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            padding-bottom: 4px;
            border-bottom: 2px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }
        .navbar-fb .zuvo-nav-link:hover,
        .navbar-fb .zuvo-nav-link.active {
            color: var(--accent) !important;
            border-bottom-color: var(--accent);
        }
        [data-theme="dark"] .navbar-fb .zuvo-nav-link {
            color: rgba(228, 230, 235, 0.5) !important;
        }
        [data-theme="dark"] .navbar-fb .zuvo-nav-link:hover,
        [data-theme="dark"] .navbar-fb .zuvo-nav-link.active {
            color: #9795ff !important;
            border-bottom-color: #9795ff;
        }

        /* ── Trailing Icon Buttons ── */
        .navbar-fb .zuvo-icon-btn {
            position: relative;
            color: var(--text-secondary);
            font-size: 1.25rem;
            cursor: pointer;
            transition: transform 0.15s, color 0.15s;
            background: none;
            border: none;
            padding: 6px;
        }
        .navbar-fb .zuvo-icon-btn:hover {
            color: var(--text-primary);
        }
        .navbar-fb .zuvo-icon-btn:active {
            transform: scale(0.95);
        }
        .navbar-fb .zuvo-icon-btn .zuvo-badge {
            position: absolute;
            top: -2px;
            right: -4px;
            width: 18px;
            height: 18px;
            background: var(--danger);
            color: white;
            font-size: 10px;
            font-weight: 700;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Legacy icon links for mobile + compat */
        .navbar-fb .nav-icon-link {
            display: flex; align-items: center; justify-content: center;
            border-radius: 12px; padding: 0.5rem 2.5rem;
            color: var(--text-secondary) !important; font-size: 1.3rem;
            text-decoration: none; transition: all 0.2s;
        }
        .navbar-fb .nav-icon-link:hover, .navbar-fb .nav-icon-link.active {
            color: var(--accent) !important;
            background-color: var(--bg-input);
        }
        .navbar-fb .nav-circle-btn {
            background-color: transparent;
            color: var(--text-secondary) !important;
            width: 40px; height: 40px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            padding: 0 !important; transition: all 0.2s;
        }
        .navbar-fb .nav-circle-btn:hover {
            background-color: var(--bg-input);
            color: var(--text-primary) !important;
        }

        /* ── Search Input ── */
        .search-nav-wrapper { position: relative; width: 280px; }
        .search-inner { position: relative; }
        .search-inner i {
            position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
            color: var(--text-muted); pointer-events: none; font-size: 0.85rem;
        }
        .search-nav-input {
            background-color: var(--bg-input) !important;
            border: none; border-radius: 50px;
            padding: 0.55rem 1.2rem 0.55rem 2.6rem;
            color: var(--text-primary) !important;
            width: 100%; font-size: 0.88rem;
            transition: background 0.2s, box-shadow 0.2s;
        }
        .search-nav-input:focus {
            box-shadow: none; outline: none;
            background-color: var(--bg-secondary) !important;
            box-shadow: inset 0 0 0 1px rgba(74,63,226,0.2);
        }
        .search-nav-input::placeholder { color: var(--text-muted); }

        /* ── Avatar in Navbar ── */
        .navbar-fb .zuvo-nav-avatar {
            width: 40px; height: 40px; border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--bg-input);
            transition: transform 0.15s, border-color 0.2s;
            cursor: pointer;
        }
        .navbar-fb .zuvo-nav-avatar:hover {
            border-color: var(--accent);
            transform: scale(1.05);
        }

        /* ── Cards — No-Line Rule ── */
        .fb-card {
            background: var(--card-bg);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            border: none;
        }
        .btn-fb-primary {
            background: var(--gradient-primary);
            color: white !important; border: none;
            font-weight: 700; border-radius: 50px;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .btn-fb-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .btn-fb-secondary {
            background-color: var(--bg-input);
            color: var(--text-primary) !important;
            border: none; font-weight: 600;
            border-radius: 12px; transition: background-color 0.2s;
        }
        .btn-fb-secondary:hover { background-color: var(--bg-input); }
        .text-fb-muted { color: var(--text-muted) !important; }
        .text-fb-primary { color: var(--text-primary) !important; }
        .list-group-item { background-color: transparent !important; border-color: transparent !important; color: inherit; }

        /* ── Dropdowns ── */
        .dropdown-menu-dark-fb {
            background-color: var(--dropdown-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--dropdown-border);
            box-shadow: var(--shadow-lg); border-radius: 16px;
        }
        .dropdown-menu-dark-fb .dropdown-item { color: var(--text-primary); font-weight: 600; }
        .dropdown-menu-dark-fb .dropdown-item:hover { background-color: var(--dropdown-item-hover); border-radius: 8px; }
        .dropdown-menu-dark-fb .dropdown-divider { border-color: var(--dropdown-divider); }
        .hover-bg-dark:hover { background-color: var(--dropdown-item-hover) !important; }

        @@media (max-width: 991px) {
            .navbar-fb .nav-icon-link {
                justify-content: flex-start; padding: 0.75rem 1rem;
                border-radius: 12px; margin-bottom: 0.25rem;
            }
            .navbar-fb .nav-icon-link:hover { background-color: var(--bg-input); }
            .navbar-nav .dropdown-menu {
                position: static; width: 100%;
                background-color: transparent; border: none;
                box-shadow: none; padding-left: 1rem;
            }
            .zuvo-nav-links { display: none !important; }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-fb px-2 px-md-3 py-1">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                <!-- Left: Brand and Search -->
                <div class="d-flex align-items-center me-3">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-bolt me-1 text-primary"></i> <span class="d-none d-xl-inline">Zuvo</span>
                    </a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="search-nav-wrapper ms-3 d-none d-md-block">
                            <div class="search-inner">
                                <i class="fas fa-search"></i>
                                <input id="navbarSearchInput" class="form-control search-nav-input" type="text" placeholder="Search Zuvo..." autocomplete="off" />
                            </div>
                            <div id="navbarSearchDropdown" class="search-nav-dropdown d-none position-absolute w-100 mt-1 rounded shadow p-2" style="z-index: 1000; background-color: var(--dropdown-bg) !important; border: 1px solid var(--dropdown-border) !important;">
                                <div id="navbarSearchState" class="text-muted small mb-2 px-2">Type at least 2 characters</div>
                                <div id="navbarSearchResults" class="search-nav-results"></div>
                                <a id="navbarSearchAllLink" class="d-none text-center d-block mt-2 small text-primary text-decoration-none" asp-controller="Search" asp-action="Index">View all results</a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Toggler -->
                <button class="navbar-toggler border-0 px-1 py-1 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Tabs & Right: Profile / Auth -->
                <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var userManager = Context.RequestServices.GetRequiredService<UserManager<ApplicationUser>>();
                        var user = await userManager.GetUserAsync(User);
                        var profilePic = user?.ProfilePictureUrl ?? "/images/user.jpg";
                        var displayUserName = user?.UserName ?? User.Identity.Name;

                        <ul class="navbar-nav mb-2 mb-lg-0 d-flex flex-row flex-wrap align-items-center mt-3 mt-lg-0" style="gap: 10px;">

                            <!-- Desktop: Text Nav Links (Stitch style) -->
                            <li class="nav-item d-none d-lg-flex me-4">
                                <div class="zuvo-nav-links">
                                    <a class="zuvo-nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                    <a class="zuvo-nav-link" asp-area="" asp-controller="Profile" asp-action="Index">Profile</a>
                                    <a class="zuvo-nav-link" asp-area="" asp-controller="Friendship" asp-action="Index">Friends</a>
                                </div>
                            </li>

                            <!-- Desktop: Trailing Icons -->
                            <li class="nav-item dropdown position-relative d-none d-lg-block">
                                <a class="zuvo-icon-btn text-decoration-none" href="#" id="navbarNotificationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                    <i class="fas fa-bell"></i>
                                    <span id="notif-badge-desktop" class="zuvo-badge" style="display:none;">0</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end mt-2 p-0 shadow-lg" aria-labelledby="navbarNotificationsDropdown" style="width: 360px; background-color: var(--dropdown-bg); border: 1px solid var(--dropdown-border); border-radius: 16px; overflow: hidden;">
                                    <div class="px-3 py-2 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid var(--dropdown-divider);">
                                        <span class="fw-bold" style="color: var(--text-primary);">Notifications</span>
                                        <button id="notif-mark-all-btn" type="button" class="btn btn-link p-0 text-decoration-none small" style="color: var(--accent);">Mark all as read</button>
                                    </div>
                                    <div id="notif-list-desktop" style="max-height: 360px; overflow-y: auto;">
                                        <div class="px-3 py-3 text-muted small">Loading...</div>
                                    </div>
                                    <div class="px-3 py-2 text-center" style="border-top: 1px solid var(--dropdown-divider);">
                                        <button id="notif-load-more-btn" type="button" class="btn btn-sm w-100" style="background-color: var(--bg-input); color: var(--text-primary); border-radius: 12px;">Load more</button>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item position-relative d-none d-lg-block">
                                <a class="zuvo-icon-btn text-decoration-none" asp-controller="Messaging" asp-action="Index" title="Messages">
                                    <i class="fas fa-envelope"></i>
                                    <span id="msg-badge-desktop" class="zuvo-badge" style="display:none;">0</span>
                                </a>
                            </li>

                            <li class="nav-item dropdown d-none d-lg-block ms-1">
                                <form id="notificationsAntiForgeryForm" class="d-none">
                                    @Html.AntiForgeryToken()
                                </form>
                                <a class="nav-link p-0 d-flex align-items-center text-decoration-none" href="#" id="navbarProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="outline: none;">
                                    <img src="@profilePic" class="zuvo-nav-avatar" title="Profile" />
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end mt-2 border-0 shadow-lg p-2 position-absolute" aria-labelledby="navbarProfileDropdown" style="width: 320px; background-color: var(--dropdown-bg);">
                                    <li class="mb-2">
                                        <a asp-controller="Profile" asp-action="Index" class="dropdown-item d-flex align-items-center p-2 rounded shadow-sm text-decoration-none" style="border: 1px solid var(--dropdown-border); color: var(--text-primary);">
                                            <img src="@profilePic" class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-bold" style="font-size: 1.05rem; color: var(--text-primary);">@displayUserName</div>
                                                <div class="small" style="color: var(--text-secondary);">See your profile</div>
                                            </div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider mx-2" style="border-top-color: var(--dropdown-divider);"></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 px-2 m-1 rounded" asp-controller="AdminPanel" asp-action="Index" style="width: auto;">
                                                <div class="nav-circle-btn me-3" style="width: 36px; height: 36px; background-color: #dc3545;"><i class="fas fa-chart-pie fs-6 text-light"></i></div>
                                                <span class="fw-semibold text-danger">Admin Dashboard</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider mx-2"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-2 m-1 rounded" asp-controller="Friendship" asp-action="Suggestions" style="width: auto;">
                                            <div class="nav-circle-btn me-3" style="width: 36px; height: 36px; background-color: var(--navbar-circle-btn);"><i class="fas fa-compass fs-6" style="color:var(--navbar-circle-icon);"></i></div>
                                            <span class="fw-semibold">Discover People</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-2 m-1 rounded" asp-controller="Home" asp-action="Privacy" style="width: auto;">
                                            <div class="nav-circle-btn me-3" style="width: 36px; height: 36px; background-color: var(--navbar-circle-btn);"><i class="fas fa-shield-alt fs-6" style="color:var(--navbar-circle-icon);"></i></div>
                                            <span class="fw-semibold">Privacy</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider mx-2"></li>
                                    <li>
                                        <div class="theme-toggle-wrap m-1">
                                            <span class="theme-toggle-label">
                                                <div class="theme-toggle-icon-wrap"><i id="themeToggleIcon" class="fas fa-sun"></i></div>
                                                <span id="themeToggleText">Dark Mode</span>
                                            </span>
                                            <label class="theme-switch" title="Toggle dark mode">
                                                <input type="checkbox" id="themeToggleCheckbox" />
                                                <span class="theme-slider"></span>
                                            </label>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider mx-2" style="border-top-color: var(--dropdown-divider);"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item d-flex align-items-center py-2 px-2 m-1 rounded bg-transparent" style="width: auto; border:none; outline:none; text-align: left; color: var(--text-primary);">
                                                <div class="nav-circle-btn me-3" style="width: 36px; height: 36px; background-color: var(--navbar-circle-btn);"><i class="fas fa-sign-out-alt fs-6" style="color:var(--navbar-circle-icon);"></i></div>
                                                <span class="fw-semibold">Logout</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>

                            <!-- Mobile Menu Links -->
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home"></i>
                                    <span class="ms-3 fs-6">Home</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-area="" asp-controller="Friendship" asp-action="Index">
                                    <i class="fas fa-user-friends"></i>
                                    <span class="ms-3 fs-6">Friends</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-area="" asp-controller="GroupChat" asp-action="Index">
                                    <i class="fas fa-users"></i>
                                    <span class="ms-3 fs-6">Groups</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-area="" asp-controller="Search" asp-action="Index">
                                    <i class="fas fa-search"></i>
                                    <span class="ms-3 fs-6">Search People</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" href="#" data-bs-toggle="offcanvas" data-bs-target="#mobileNotificationsOffcanvas">
                                    <i class="fas fa-bell"></i>
                                    <span class="ms-3 fs-6">Notifications</span>
                                    <span id="notif-badge-mobile" class="badge bg-danger ms-2 rounded-pill" style="display:none;">0</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-controller="Messaging" asp-action="Index">
                                    <i class="fas fa-envelope"></i>
                                    <span class="ms-3 fs-6">Messages</span>
                                    <span id="msg-badge-mobile" class="badge bg-danger ms-2 rounded-pill" style="display:none;">0</span>
                                </a>
                            </li>
                            <li class="nav-item d-lg-none mt-1 border-top border-secondary pt-2 w-100">
                                <a class="nav-icon-link px-2 justify-content-start" asp-controller="Profile" asp-action="Index">
                                    <img src="@profilePic" class="rounded-circle me-3" style="width:30px; height:30px; object-fit:cover;" />
                                    <span class="fs-6">Profile</span>
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 mt-2 mt-lg-0 d-flex flex-row align-items-center gap-2">
                            <li class="nav-item">
                                <a class="nav-link text-decoration-none" asp-area="" asp-controller="Account" asp-action="Login" style="color: var(--text-primary); font-weight: 500;">
                                    <i class="fas fa-sign-in-alt me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-fb-primary px-3 py-1" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i> Sign Up
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNotificationsOffcanvas" aria-labelledby="mobileNotificationsOffcanvasLabel" style="background: var(--offcanvas-bg); color: var(--text-primary);">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title" id="mobileNotificationsOffcanvasLabel">Notifications</h5>
                <div class="d-flex align-items-center gap-3">
                    <button id="notif-mark-all-mobile-btn" type="button" class="btn btn-link p-0 text-decoration-none small" style="color:#2d88ff;">Mark all as read</button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
            </div>
            <div class="offcanvas-body p-0">
                <div id="notif-list-mobile" style="max-height: calc(100vh - 80px); overflow-y: auto;">
                    <div class="px-3 py-3 text-muted small">Loading...</div>
                </div>
                <div class="px-3 py-2 border-top border-secondary text-center">
                    <button id="notif-load-more-mobile-btn" type="button" class="btn btn-sm btn-outline-light w-100">Load more</button>
                </div>
            </div>
        </div>

        <div id="notif-toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1200;"></div>
    }

    <div class="container" style="padding-top: 80px;">

        @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
        {
            <style>
                .zuvo-toast {
                    position: fixed;
                    top: 90px;
                    right: 24px;
                    z-index: 9999;
                    min-width: 320px;
                    max-width: 460px;
                    padding: 16px 20px;
                    border-radius: 12px;
                    font-size: 15px;
                    font-weight: 600;
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    box-shadow: 0 10px 40px rgba(0,0,0,.5);
                    animation: toastSlideIn .4s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
                    cursor: pointer;
                    backdrop-filter: blur(12px);
                    -webkit-backdrop-filter: blur(12px);
                }
                .zuvo-toast.success {
                    background: rgba(45, 184, 77, 0.95);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    color: #fff;
                }
                .zuvo-toast.error {
                    background: rgba(232, 63, 56, 0.95);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    color: #fff;
                }
                .zuvo-toast i { font-size: 22px; flex-shrink: 0; }
                .zuvo-toast .toast-msg { flex: 1; color: #fff; }
                .zuvo-toast .toast-close {
                    background: none; border: none; color: rgba(255,255,255,0.75);
                    font-size: 20px; line-height: 1; cursor: pointer; padding: 0 4px;
                    transition: color .15s;
                }
                .zuvo-toast .toast-close:hover { color: #fff; }
                @@keyframes toastSlideIn {
                    from { opacity: 0; transform: translateX(60px) scale(0.95); }
                    to   { opacity: 1; transform: translateX(0) scale(1); }
                }
                @@keyframes toastSlideOut {
                    from { opacity: 1; transform: translateX(0) scale(1); }
                    to   { opacity: 0; transform: translateX(60px) scale(0.95); }
                }
            </style>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="zuvo-toast success" id="zuvo-success-toast" onclick="this.style.animation='toastSlideOut .3s ease forwards'; setTimeout(()=>this.remove(), 300);">
                    <i class="fas fa-check-circle"></i>
                    <span class="toast-msg">@TempData["SuccessMessage"]</span>
                    <button class="toast-close" type="button">&times;</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="zuvo-toast error" id="zuvo-error-toast" onclick="this.style.animation='toastSlideOut .3s ease forwards'; setTimeout(()=>this.remove(), 300);">
                    <i class="fas fa-exclamation-circle"></i>
                    <span class="toast-msg">@TempData["ErrorMessage"]</span>
                    <button class="toast-close" type="button">&times;</button>
                </div>
            }

            <script>
                setTimeout(function() {
                    document.querySelectorAll('.zuvo-toast').forEach(function(t) {
                        t.style.animation = 'toastSlideOut .3s ease forwards';
                        setTimeout(function() { t.remove(); }, 300);
                    });
                }, 5000);
            </script>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Global Edit Post Modal -->
        <div class="modal fade" id="editPostModal" tabindex="-1" aria-labelledby="editPostModalLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0" style="background: var(--modal-bg); border: 1px solid var(--card-border) !important;">
                    <form id="editPostModalForm" asp-controller="Post" asp-action="EditPost" method="post" enctype="multipart/form-data">
                        <div class="modal-header" style="border-bottom: 1px solid var(--dropdown-divider);">
                            <h5 class="modal-title fw-bold" id="editPostModalLabel" style="color:var(--text-primary);">Edit Post</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-3">
                            <input type="hidden" name="Id" id="editPostId" />
                            <textarea name="Content" id="editPostContent" class="form-control" rows="4" style="background:var(--modal-input-bg); border:1px solid var(--modal-input-border); color:var(--text-primary); resize:none;" required></textarea>
                            
                            <div class="mt-3">
                                <label class="form-label small mb-1" style="color:var(--text-muted);">Update Image (optional)</label>
                                <input type="file" name="image" id="editPostImage" class="form-control" style="background:var(--modal-input-bg); border:1px solid var(--modal-input-border); color:var(--text-primary);" accept="image/*" />
                            </div>
                        </div>
                        <div class="modal-footer border-0" style="border-top: 1px solid var(--dropdown-divider) !important;">
                            <button type="button" class="btn fw-semibold" data-bs-dismiss="modal" style="background: var(--navbar-circle-btn); color: var(--text-primary);">Cancel</button>
                            <button type="submit" class="btn text-white fw-bold" style="background: var(--accent);">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Global Delete Confirmation Modal -->
        <div class="modal fade" id="deletePostModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0" style="background: var(--modal-bg); border: 1px solid var(--card-border) !important;">
                    <form id="deletePostModalForm" asp-controller="Post" asp-action="DeletePost" method="post">
                        <div class="modal-header" style="border-bottom: 1px solid var(--dropdown-divider);">
                            <h6 class="modal-title fw-bold" style="color:var(--text-primary);">Delete Post?</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body small" style="color:var(--text-secondary);">
                            Are you sure you want to delete this post? This action cannot be undone.
                            <input type="hidden" name="postId" id="deletePostId" />
                        </div>
                        <div class="modal-footer border-0 pb-3 justify-content-center">
                            <button type="button" class="btn btn-sm px-3 fw-semibold" data-bs-dismiss="modal" style="background: var(--navbar-circle-btn); color: var(--text-primary);">Cancel</button>
                            <button type="submit" class="btn btn-danger btn-sm px-3">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            // ── Navbar unread DM badge polling ────────────────────────────────
            async function refreshMsgBadge() {
                try {
                    const res  = await fetch('/Messaging/UnreadCount');
                    if (!res.ok) return;
                    const data = await res.json();
                    const bDesktop = document.getElementById('msg-badge-desktop');
                    const bMobile = document.getElementById('msg-badge-mobile');
                    if (bDesktop) {
                        bDesktop.textContent = data.count;
                        bDesktop.style.display = data.count > 0 ? 'inline-block' : 'none';
                    }
                    if (bMobile) {
                        bMobile.textContent = data.count;
                        bMobile.style.display = data.count > 0 ? 'inline-block' : 'none';
                    }
                } catch { /* ignore network errors */ }
            }
            refreshMsgBadge();
            setInterval(refreshMsgBadge, 30000); // refresh every 30 seconds

            // ── Notifications list + badge ────────────────────────────────────
            const notifListDesktop = document.getElementById('notif-list-desktop');
            const notifListMobile = document.getElementById('notif-list-mobile');
            const notifBadgeDesktop = document.getElementById('notif-badge-desktop');
            const notifBadgeMobile = document.getElementById('notif-badge-mobile');
            const notifMarkAllBtn = document.getElementById('notif-mark-all-btn');
            const notifMarkAllMobileBtn = document.getElementById('notif-mark-all-mobile-btn');
            const notifLoadMoreBtn = document.getElementById('notif-load-more-btn');
            const notifLoadMoreMobileBtn = document.getElementById('notif-load-more-mobile-btn');
            const notifToastContainer = document.getElementById('notif-toast-container');
            let notificationItems = [];
            const notifTake = 5;
            let notifLoading = false;

            function escapeHtml(text) {
                return String(text ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function relativeTime(dateInput) {
                const date = new Date(dateInput);
                const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
                if (Number.isNaN(seconds)) return '';
                if (seconds < 60) return 'Just now';
                const minutes = Math.floor(seconds / 60);
                if (minutes < 60) return `${minutes}m ago`;
                const hours = Math.floor(minutes / 60);
                if (hours < 24) return `${hours}h ago`;
                const days = Math.floor(hours / 24);
                if (days < 7) return `${days}d ago`;
                return date.toLocaleDateString();
            }

            function notificationTypeLabel(type) {
                if (typeof type === 'string') return type;
                const map = {
                    1: 'FriendRequest',
                    2: 'Message',
                    3: 'PostReaction',
                    4: 'Comment',
                    5: 'GroupInvitation'
                };
                return map[type] ?? 'Notification';
            }

            function getAntiForgeryToken() {
                return document.querySelector('#notificationsAntiForgeryForm input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || '';
            }

            function notificationIcon(type) {
                const label = notificationTypeLabel(type);
                switch (label) {
                    case 'Message': return 'fa-envelope';
                    case 'Comment': return 'fa-comment';
                    case 'PostReaction': return 'fa-heart';
                    case 'FriendRequest': return 'fa-user-plus';
                    default: return 'fa-bell';
                }
            }

            function applyUnreadCount(unread) {
                if (notifBadgeDesktop) {
                    notifBadgeDesktop.textContent = unread;
                    notifBadgeDesktop.style.display = unread > 0 ? 'inline-block' : 'none';
                }
                if (notifBadgeMobile) {
                    notifBadgeMobile.textContent = unread;
                    notifBadgeMobile.style.display = unread > 0 ? 'inline-block' : 'none';
                }

                if (notifMarkAllBtn) {
                    notifMarkAllBtn.disabled = unread === 0;
                    notifMarkAllBtn.style.opacity = unread === 0 ? '0.5' : '1';
                    notifMarkAllBtn.style.pointerEvents = unread === 0 ? 'none' : 'auto';
                }

                if (notifMarkAllMobileBtn) {
                    notifMarkAllMobileBtn.disabled = unread === 0;
                    notifMarkAllMobileBtn.style.opacity = unread === 0 ? '0.5' : '1';
                    notifMarkAllMobileBtn.style.pointerEvents = unread === 0 ? 'none' : 'auto';
                }
            }

            function updateNotificationBadges() {
                const unread = notificationItems.filter(n => !n.isRead).length;
                applyUnreadCount(unread);
            }

            function updateLoadMoreButtons() {
                const show = notificationItems.length >= notifTake;

                if (notifLoadMoreBtn) {
                    notifLoadMoreBtn.disabled = false;
                    notifLoadMoreBtn.style.display = show ? 'inline-block' : 'none';
                }

                if (notifLoadMoreMobileBtn) {
                    notifLoadMoreMobileBtn.disabled = false;
                    notifLoadMoreMobileBtn.style.display = show ? 'inline-block' : 'none';
                }
            }

            function renderNotificationList() {
                if (!notificationItems.length) {
                    if (notifListDesktop) {
                        notifListDesktop.innerHTML = '<div class="px-3 py-3 text-muted small">No notifications yet.</div>';
                    }
                    if (notifListMobile) {
                        notifListMobile.innerHTML = '<div class="px-3 py-3 text-muted small">No notifications yet.</div>';
                    }
                    return;
                }

                const html = notificationItems.map(n => `
                    <button type="button" class="w-100 text-start px-3 py-2 border-0 notification-item" data-notification-id="${n.id}" data-action-url="${escapeHtml(n.actionUrl ?? '')}" style="transition: background-color 0.2s; background-color: ${n.isRead ? 'transparent' : 'var(--modal-input-bg)'}; border-bottom: 1px solid var(--dropdown-divider) !important;">
                        <div class="d-flex align-items-start gap-2">
                            <div class="mt-1"><i class="fas ${notificationIcon(n.type)} text-primary"></i></div>
                            <div class="flex-grow-1">
                                <div class="small fw-semibold" style="color: var(--text-primary);">${escapeHtml(n.content)}</div>
                                <div class="small text-muted">${relativeTime(n.createdAt)}</div>
                            </div>
                            ${n.isRead ? '' : '<span class="badge bg-primary rounded-pill" style="font-size:0.55rem;">new</span>'}
                        </div>
                    </button>
                `).join('');

                if (notifListDesktop) {
                    notifListDesktop.innerHTML = html;
                }
                if (notifListMobile) {
                    notifListMobile.innerHTML = html;
                }
            }

            async function loadNotifications() {
                if (notifLoading) return;
                notifLoading = true;
                updateLoadMoreButtons();

                try {
                    const res = await fetch(`/Notifications/List?take=${notifTake}&skip=0`);
                    if (!res.ok) return;

                    const items = await res.json();
                    notificationItems = items;
                    renderNotificationList();
                    updateNotificationBadges();
                } catch {
                    if (notifListDesktop) {
                        notifListDesktop.innerHTML = '<div class="px-3 py-3 text-danger small">Failed to load notifications.</div>';
                    }
                    if (notifListMobile) {
                        notifListMobile.innerHTML = '<div class="px-3 py-3 text-danger small">Failed to load notifications.</div>';
                    }
                } finally {
                    notifLoading = false;
                    updateLoadMoreButtons();
                }
            }

            async function refreshNotificationBadgesLight() {
                try {
                    const res = await fetch('/Notifications/UnreadCount');
                    if (!res.ok) return;
                    const data = await res.json();
                    applyUnreadCount(data.count ?? 0);
                } catch { /* ignore network errors */ }
            }

            function prependRealtimeNotification(payload) {
                const item = {
                    id: payload.id ?? (crypto.randomUUID ? crypto.randomUUID() : String(Date.now())),
                    type: payload.type,
                    content: payload.message,
                    actionUrl: payload.actionUrl ?? '',
                    isRead: false,
                    createdAt: payload.createdAt ?? new Date().toISOString(),
                    senderId: null,
                    senderName: 'Unknown',
                    senderProfilePictureUrl: null
                };
                notificationItems = [item, ...notificationItems].slice(0, notifTake);
                renderNotificationList();
                updateNotificationBadges();
                showRealtimeNotificationToast(item);

                if (!payload.id) {
                    setTimeout(loadNotifications, 1000);
                }
            }

            function showRealtimeNotificationToast(notification) {
                if (!notifToastContainer || !window.bootstrap?.Toast) return;

                const toastEl = document.createElement('div');
                toastEl.className = 'toast text-bg-dark border border-secondary';
                toastEl.setAttribute('role', 'alert');
                toastEl.setAttribute('aria-live', 'assertive');
                toastEl.setAttribute('aria-atomic', 'true');
                toastEl.innerHTML = `
                    <div class="toast-header bg-dark text-light border-secondary">
                        <i class="fas ${notificationIcon(notification.type)} text-primary me-2"></i>
                        <strong class="me-auto">New notification</strong>
                        <small class="text-muted">now</small>
                        <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">
                        ${escapeHtml(notification.content)}
                    </div>
                `;

                notifToastContainer.appendChild(toastEl);
                const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
                toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                toast.show();
            }

            async function markNotificationAsRead(notificationId) {
                if (!notificationId) return false;

                const notification = notificationItems.find(n => String(n.id) === String(notificationId));
                if (!notification) return false;
                if (notification.isRead) return true;

                notification.isRead = true;
                renderNotificationList();
                updateNotificationBadges();

                try {
                    const token = getAntiForgeryToken();
                    const fd = new FormData();
                    fd.append('id', notificationId);
                    fd.append('__RequestVerificationToken', token);

                    const res = await fetch('/Notifications/MarkAsRead', {
                        method: 'POST',
                        body: fd
                    });

                    if (!res.ok) {
                        notification.isRead = false;
                        renderNotificationList();
                        updateNotificationBadges();
                        return false;
                    }
                } catch {
                    notification.isRead = false;
                    renderNotificationList();
                    updateNotificationBadges();
                    return false;
                }

                return true;
            }

            async function markAllNotificationsAsRead() {
                const unreadItems = notificationItems.filter(n => !n.isRead);
                if (unreadItems.length === 0) return;

                const prevState = notificationItems.map(n => ({ ...n }));
                notificationItems = notificationItems.map(n => ({ ...n, isRead: true }));
                renderNotificationList();
                updateNotificationBadges();

                try {
                    const token = getAntiForgeryToken();
                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', token);

                    const res = await fetch('/Notifications/MarkAllAsRead', {
                        method: 'POST',
                        body: fd
                    });

                    if (!res.ok) {
                        notificationItems = prevState;
                        renderNotificationList();
                        updateNotificationBadges();
                    }
                } catch {
                    notificationItems = prevState;
                    renderNotificationList();
                    updateNotificationBadges();
                }
            }

            loadNotifications();
            refreshNotificationBadgesLight();
            setInterval(refreshNotificationBadgesLight, 30000);

            // ── NotificationHub realtime listener ─────────────────────────────
            const notificationConnection = new signalR.HubConnectionBuilder()
                .withUrl('/notificationhub')
                .withAutomaticReconnect()
                .build();
          
            notificationConnection.on('ReceiveNotification', (payload) => {
                if (!payload || !payload.message) return;
                prependRealtimeNotification(payload);
            });

            notificationConnection.start().catch(() => {});

            const chatConnection = new signalR.HubConnectionBuilder()
                .withUrl('/chathub')
                .withAutomaticReconnect()
                .build();

            chatConnection.on('UserOnlineStatus', (userId, isOnline) => {

            });

            chatConnection.start().catch((err) => console.error("ChatHub Connection Error: ", err));
            notifListDesktop?.addEventListener('click', async (e) => {
                const target = e.target instanceof HTMLElement ? e.target.closest('.notification-item') : null;
                if (!target) return;
                const id = target.getAttribute('data-notification-id');
                const actionUrl = target.getAttribute('data-action-url');
                if (id) {
                    const ok = await markNotificationAsRead(id);
                    if (ok && actionUrl) {
                        window.location.href = actionUrl;
                    }
                }
            });

            notifListMobile?.addEventListener('click', async (e) => {
                const target = e.target instanceof HTMLElement ? e.target.closest('.notification-item') : null;
                if (!target) return;
                const id = target.getAttribute('data-notification-id');
                const actionUrl = target.getAttribute('data-action-url');
                if (id) {
                    const ok = await markNotificationAsRead(id);
                    if (ok && actionUrl) {
                        window.location.href = actionUrl;
                    }
                }
            });

            notifMarkAllBtn?.addEventListener('click', () => {
                markAllNotificationsAsRead();
            });

            notifMarkAllMobileBtn?.addEventListener('click', () => {
                markAllNotificationsAsRead();
            });

            notifLoadMoreBtn?.addEventListener('click', () => {
                window.location.href = '/Notifications';
            });

            notifLoadMoreMobileBtn?.addEventListener('click', () => {
                window.location.href = '/Notifications';
            });

            const desktopDropdown = document.getElementById('navbarNotificationsDropdown');
            desktopDropdown?.addEventListener('shown.bs.dropdown', () => {
                loadNotifications();
            });

            const mobileOffcanvas = document.getElementById('mobileNotificationsOffcanvas');
            mobileOffcanvas?.addEventListener('show.bs.offcanvas', () => {
                loadNotifications();
            });
        </script>
    }
    <!-- ===== Theme Toggle Script ===== -->
    <script>
        (function () {
            var checkbox = document.getElementById('themeToggleCheckbox');
            var icon = document.getElementById('themeToggleIcon');
            var text = document.getElementById('themeToggleText');
            var html = document.documentElement;

            function applyTheme(theme) {
                html.setAttribute('data-theme', theme);
                if (checkbox) checkbox.checked = (theme === 'dark');
                if (icon) {
                    icon.className = theme === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
                }
                if (text) {
                    text.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
                }
            }

            // Sync on load
            var saved = localStorage.getItem('zuvo-theme') || 'light';
            applyTheme(saved);

            // Toggle handler
            if (checkbox) {
                checkbox.addEventListener('change', function () {
                    var newTheme = checkbox.checked ? 'dark' : 'light';
                    localStorage.setItem('zuvo-theme', newTheme);
                    applyTheme(newTheme);
                });
            }
        })();
    </script>
</body>
</html>
